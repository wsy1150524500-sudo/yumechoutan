@startuml 权限验证与封禁检查流程图
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 12

start

:接收 HTTP 请求;

:从请求头提取
Authorization 字段;

if (Authorization 是否存在？) then (否)
  :返回 401
  "未提供认证令牌";
  stop
else (是)
endif

:提取 Bearer Token
split(' ')[1];

if (Token 是否存在？) then (否)
  :返回 401
  "未提供认证令牌";
  stop
else (是)
endif

:调用 jwt.verify(token, JWT_SECRET);

if (验证是否成功？) then (否)
  :返回 403
  "令牌无效或已过期";
  stop
else (是)
endif

:将解码后的用户信息
注入 req.user;

if (当前路由是否为\n管理员接口 /api/admin/* ？) then (否)
  :直接放行
  执行业务逻辑;
  stop
else (是)
endif

:查询数据库
SELECT is_admin FROM users
WHERE id = req.user.id;

if (用户存在且\nis_admin 为 true？) then (否)
  :返回 403
  "需要管理员权限";
  stop
else (是)
endif

:放行
执行管理业务逻辑;

stop

@enduml
